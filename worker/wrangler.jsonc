{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "constellation-exhibition-api",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "VR_MONITOR", "class_name": "VRMonitorRoom" }] },
  "migrations": [{ "tag": "vr-monitor-v1", "new_sqlite_classes": ["VRMonitorRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "constellation-exhibition",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "PUBLIC_ORIGIN": "https://configure-your-vercel-domain.invalid" },
}
