{
  "name": "constellation-studio",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-exhibition.mjs",
    "dev:canvas": "vite --host 127.0.0.1",
    "db:local": "wrangler d1 migrations apply DB --local --config worker/wrangler.jsonc",
    "exhibition:prepare": "node scripts/prepare-exhibition.mjs",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:exhibition": "node tests/browser-exhibition.mjs",
    "test:ar": "node tests/browser-ar.mjs",
    "test:presence": "node tests/browser-presence.mjs",
    "test:catalogue": "node tests/browser-catalogue.mjs",
    "catalogue:import": "node scripts/import-constellations.mjs",
    "catalogue:imagined": "node scripts/build-imagined.mjs",
    "setup:vision": "node scripts/setup-vision.mjs",
    "postinstall": "node scripts/setup-vision.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@tensorflow-models/pose-detection": "2.1.3",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "lucide": "0.468.0",
    "qrcode": "1.5.4",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "8.3.0",
    "wrangler": "^4.151.0"
  }
}
